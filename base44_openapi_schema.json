{
  "openapi": "3.0.3",
  "info": {
    "title": "TutorPilot Bar Mitzvah Companion Database API",
    "description": "REST API interface for Rabbi Closter's Base44 AI Agent to schedule lessons, log debriefs, auto-check off completed curriculum topics across the 36 lessons, plan upcoming classes with preparation notes, and enrich study materials in real time.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://bpkwnqbabokesuesvkex.supabase.co/rest/v1",
      "description": "Production Supabase Database REST API"
    }
  ],
  "paths": {
    "/students_sync": {
      "get": {
        "summary": "List all Bar Mitzvah students, calendar lessons, and curriculum additions",
        "description": "Retrieves all synced student records and custom study materials from the database. Each record contains the student profile, lessons schedule in completed_topics._meta.schedule, and curriculum progress in completed_topics and completed_parshiot.",
        "operationId": "listStudentsAndSchedule",
        "parameters": [
          {
            "name": "select",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*"
            },
            "description": "PostgREST columns selection string"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by student ID or pass eq.__study_materials__ for custom lesson additions"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by student name using PostgREST ilike pattern e.g. ilike.*Ethan*"
          }
        ],
        "responses": {
          "200": {
            "description": "List of student and schedule records returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StudentSyncRecord"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upsert student profile, schedule a lesson, log debrief, or add study materials",
        "description": "Creates or updates a student profile, calendar schedule, completed topics checklist, or curriculum additions under __study_materials__.",
        "operationId": "upsertStudentRecord",
        "parameters": [
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "resolution=merge-duplicates"
            },
            "description": "Instructs Supabase to perform an upsert based on the primary key id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentSyncRecord"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Record upserted successfully and broadcast via Supabase Realtime"
          }
        }
      },
      "delete": {
        "summary": "Delete a student record",
        "description": "Removes a student profile from the database",
        "operationId": "deleteStudentRecord",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "e.g. eq.stu_1793736006299"
          }
        ],
        "responses": {
          "204": {
            "description": "Record deleted successfully"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "Supabase Publishable Anon API Key"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Supabase Bearer Token (same as apikey)"
      }
    },
    "schemas": {
      "StudentSyncRecord": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier prefixed with stu_ or __study_materials__ for curriculum materials",
            "example": "stu_1793800000000"
          },
          "name": {
            "type": "string",
            "description": "Full name of the Bar Mitzvah student or SYSTEM_STUDY_MATERIALS",
            "example": "Ethan Miller"
          },
          "parsha_or_date": {
            "type": "string",
            "description": "Torah Parsha or Bar Mitzvah Date",
            "example": "Parshat Lech Lecha"
          },
          "notes": {
            "type": "string",
            "description": "Tutor notes, progress remarks, and lesson debrief summaries",
            "example": "Completed Tefillin wrapping test. Working on Haftarah blessings."
          },
          "completed_topics": {
            "type": "object",
            "description": "Mastery checklist for 13 Jewish concepts (key: boolean) and metadata container for calendar lessons. When id is __study_materials__, contains custom notes per lesson key.",
            "properties": {
              "_meta": {
                "type": "object",
                "properties": {
                  "parsha": { "type": "string" },
                  "barMitzvahDate": { "type": "string" },
                  "schedule": {
                    "type": "array",
                    "description": "Calendar tutoring sessions matching portal calendar day view",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "example": "les_1793800000000" },
                        "dateStr": { "type": "string", "example": "2026-11-12" },
                        "dayOfWeek": { "type": "integer", "example": 4 },
                        "time": { "type": "string", "example": "4:30 PM" },
                        "repeatWeekly": { "type": "boolean", "default": false },
                        "topic": { "type": "string", "example": "Next to teach: Kashrut (Meat & dairy separation rules)" }
                      }
                    }
                  },
                  "lessons": {
                    "type": "array",
                    "description": "Mirror array for compatibility",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "date": { "type": "string", "example": "2026-11-12" },
                        "timeSlot": { "type": "string", "example": "4:30 PM" },
                        "subject": { "type": "string" },
                        "notes": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "completed_parshiot": {
            "type": "object",
            "description": "Mastery checklist for Chumash parshiot (key: boolean)"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO timestamp of last update"
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyHeader": [],
      "bearerAuth": []
    }
  ]
}
